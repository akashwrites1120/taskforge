# TaskForge environment template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit credentials.

# Neon Postgres connection string.
# Long-running apps (backend server, migrations): use the DIRECT string
# (host without "-pooler") — the app pools connections itself via pgxpool.
# Serverless/many-client setups: use the POOLED string instead (see README).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Backend config (sane defaults, override only if needed)
PORT=8080
WORKER_CONCURRENCY=10
POLL_INTERVAL=5s
REAPER_INTERVAL=15s
